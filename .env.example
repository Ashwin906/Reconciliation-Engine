

# --- Real Razorpay account (optional) ---
# Set these to reconcile a REAL merchant account instead of a simulation.
# Read by the SERVER only -- never accepted through the API or typed into
# the dashboard (DECISIONS.md D-33). Every call this system makes to
# Razorpay is a GET; it cannot write to your account.
# Start with TEST-mode keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
